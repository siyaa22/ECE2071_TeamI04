import numpy as np
import wave
import serial
import serial.tools.list_ports
import matplotlib.pyplot as plt
import keyboard

def waves(data):
    filename = f"I04_sample_rate_{SAMPLE_RATE}Hz.wav"
    with wave.open(filename, 'wb') as wf:
        wf.setnchannels(1) # mono audio (single channel)
        wf.setsampwidth(1) # 8 bits (1 byte ) per sample
        wf.setframerate(SAMPLE_RATE) # set the sample rate that the data was recorded at
        wf.writeframes(data.tobytes()) # write the audio data to the file
def csv(data):
    # export as csv file
    time = np.arange(len(data))
    csv_data = np.column_stack((time/SAMPLE_RATE, data))
    csv_name = f"I04_sample_rate_{SAMPLE_RATE}Hz.csv"
    np.savetxt(csv_name, csv_data, delimiter = ",", header = "Time(s), Amplitude", comments = "")
def png(data):
    # export as png plot
    time = np.arange(len(data))
    plt.plot(time/SAMPLE_RATE, data, "o")
    plt.title("Audio Waveform (Amplitude vs Time)")
    plt.xlabel("time(s)")
    plt.ylabel("amplitude")
    png_name = f"I04_sample_rate_{SAMPLE_RATE}Hz.png"
    plt.savefig(png_name)

